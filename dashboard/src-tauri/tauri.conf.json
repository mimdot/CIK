{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Astra",
  "version": "1.0.0",
  "identifier": "com.careerintelligence.kit",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "TAURI=true npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Astra",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecar/api/cik-api"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
