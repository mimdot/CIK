# Career Intelligence Kit — environment variables (Sprint 05, B2).
# Copy to `.env` and fill in values. docker-compose reads this file.

# ---- Security ---------------------------------------------------------------
# JWT signing key. MUST be a long random string in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CIK_SECRET_KEY=

# Comma-separated origins allowed to call the API (no trailing slash).
# Dev:  http://localhost:3000
# Prod: https://dashboard.example.com
CORS_ORIGINS=http://localhost:3000

# Cookies carry the Secure flag by default (required behind TLS). Set to 0 for
# plain-HTTP local development — browsers refuse Secure cookies on
# http://localhost origins, which silently breaks browser sessions.
#CIK_COOKIE_SECURE=0

# ---- Database ---------------------------------------------------------------
# SQLAlchemy URL. The API defaults to a local sqlite file if unset.
DATABASE_URL=sqlite:////data/phd_data.db

# ---- Cache + Jobs ------------------------------------------------------------
# Redis connection used for the result cache (B1) and the rq job queue (B2).
# When unset (or Redis unreachable) the API falls back to an in-memory cache.
REDIS_URL=redis://localhost:6379/0

# ---- Error tracking -----------------------------------------------------------
# Sentry DSN (https://sentry.io). When unset, Sentry is not initialized.
SENTRY_DSN=

# ---- Private beta -------------------------------------------------------------
# Require an invite code during registration (Sprint 06, C1)? Defaults to OFF
# (open registration); set to 1/true to require one. The older INVITES_REQUIRED
# name still works as a fallback.
#CIK_INVITE_REQUIRED=1

# ---- LLM (profile extraction / match explanation) ---------------------------
# Primary + fallback model ids. Litellm model strings; any provider works.
# Free/high-limit setup: Groq primary + Gemini 2.5 Flash fallback.
LLM_DEFAULT_MODEL=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=gemini/gemini-2.5-flash

# Optional provider failover chain (highest capacity first). When set, it
# overrides LLM_DEFAULT_MODEL/LLM_FALLBACK_MODEL and every lane is tried in
# order. Example used for the local beta on this device:
# LLM_MODEL_CHAIN=gemini/gemini-2.5-flash-lite,mistral/mistral-large-latest,openai/gpt-4o-mini
LLM_MODEL_CHAIN=
# Retries per non-final lane before the next provider is tried. 1 keeps
# failover snappy when a lane is network-blocked.
LLM_CHAIN_RETRIES=2

# Provider credentials. litellm reads these directly.
#   Groq (free, ~14,400 req/day):  https://console.groq.com/keys
#   Gemini (free 250 req/day, paid ~$0.30/M in):  https://aistudio.google.com/apikey
#   Mistral La Plateforme (big free monthly volume): https://console.mistral.ai/api-keys
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=

# ---- Literature APIs (supervisor finder) ------------------------------------
# NASA ADS API token (https://ui.adsabs.harvard.edu/user/settings/token).
ADS_API_TOKEN=
# Email for the OpenAlex polite pool (rate-limit friendly).
OPENALEX_MAILTO=

# ---- Dashboard ---------------------------------------------------------------
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Production (Sprint 10) ---------------------------------------------------
# Public domains Caddy serves + reverse-proxies with automatic TLS.
#   API_DOMAIN=api.example.com
#   DASHBOARD_DOMAIN=dashboard.example.com
#   CORS_ORIGINS=https://dashboard.example.com
#   NEXT_PUBLIC_API_URL=https://api.example.com
API_DOMAIN=api.example.com
DASHBOARD_DOMAIN=dashboard.example.com

# API capacity + scheduler (docs/DEPLOYMENT.md section 6).
API_WORKERS=1
# Run the weekly-digest scheduler in this process (set 0 on extra API workers
# when API_WORKERS>1, so the cron is registered exactly once).
CIK_SCHEDULER_ENABLED=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# SSRF guard (Sprint 10, D1) — keep on in production; off only for local work.
CIK_SSRF_GUARD=1

# Backups (docs/BACKUPS.md) — run scripts/backup.sh from a nightly cron.
BACKUP_OBJECT_STORE=   # s3://bucket/path or local dir
BACKUP_AGE_PUBLIC_KEY=
BACKUP_RETENTION_DAYS=14

# Observability (docs/MONITORING.md) — 1 = one JSON object per log line.
CIK_JSON_LOGS=1
