__pycache__/
*.py[cod]
*.pyc
*.egg-info/
.pytest_cache/
.pw_profile/
.venv/
venv/
*.log
emails/
astra_positions*.json
astra_positions*.csv
astra_positions*.html

# Secrets and personal data
.env
.env.*
!.env.example
astra/vpn.txt
astra/applicant.yaml
astra/*.yaml
!astra/applicant.example.yaml
!astra/config.yaml
# Shipped data, not user data: the position-type registry (Phase 2C). The
# blanket *.yaml rule above exists to keep applicant.yaml / vpn.txt out of
# git, and would otherwise silently drop any new data file added here.
!astra/position_types.yaml

# Runtime state
astra/.seen_positions.json
astra/astra_positions_selftest*.csv
astra/astra_positions_selftest*.html
astra/astra_positions_selftest*.json

# SQLite runtime DBs (recreated on first run; see DEFAULT_DB_URL)
astra.db
astra.db.bak

# HTTP conditional-GET cache (M2)
.http_cache.sqlite
.http_cache.sqlite-journal
.http_cache.sqlite-wal
.http_cache.sqlite-shm
*.db-journal
*.db-wal
*.db-shm

# Supervisor finder outputs (supervisors_<field>_<country>.*)
astra/supervisors_*.csv
astra/supervisors_*.json
astra/supervisors_*.html

# Build / packaging artifacts (PyInstaller sidecar, zips, logs)
astra/build/
astra/dist/
*.zip
nohup.out

# Uploaded CVs — never commit user data (Phase 2B upload dir)
astra/uploads/
uploads/

# Agent/tooling workspaces
.opencode/

# Local scratch: internal dev-diary docs, one-off notes, build artifacts —
# not part of the published repo. See Extra/README.md for what's in here.
Extra/

# Tauri: the staged PyInstaller sidecars + generated files (rebuilt by
# `tauri build`, run.sh and run.ps1).
#
# The whole directory, not a list of per-triple patterns. It holds nothing but
# build output now that the bash wrapper is gone — lib.rs spawns the sidecar
# itself — and each staged binary is 150-350 MB, well over GitHub's 100 MB
# hard limit. A pattern list only has to miss one new target triple
# (aarch64-pc-windows-msvc, say) for a push to be rejected outright.
dashboard/src-tauri/sidecar/
dashboard/src-tauri/gen/

# Local dev-tool state, not part of the product
.claude/
.codegraph/
